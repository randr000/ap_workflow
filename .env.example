# Copy to .env and adjust. The demo runs fully without any of these set.

# SQLite database used by the Streamlit app and API
AP_DATABASE_URL=sqlite:///ap_demo.db

# LLM provider: "mock" (deterministic, no API key) or "openai" (any OpenAI-compatible API)
AP_LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Matching tolerances (price variance must be within BOTH limits)
AP_QUANTITY_TOLERANCE=0
AP_PRICE_TOLERANCE_AMOUNT=25.00
AP_PRICE_TOLERANCE_PERCENT=5.0

# AI coding confidence bands
AP_CONFIDENCE_STRAIGHT_THROUGH=0.90
AP_CONFIDENCE_REVIEW=0.75

# Approval thresholds
AP_AUTO_APPROVAL_LIMIT=1000.00
AP_CONTROLLER_THRESHOLD=10000.00

# Duplicate detection look-back window for same-vendor/same-amount matches
AP_DUPLICATE_WINDOW_DAYS=60
