# Copy to .env and adjust. The demo runs fully without any of these set.

# SQLite database used by the Streamlit app and API
AP_DATABASE_URL=sqlite:///ap_demo.db

# LLM provider: "mock" (deterministic, no network), "ollama" (local / LAN model),
# or "openai" (any OpenAI-compatible API). The provider can also be switched in the UI sidebar.
AP_LLM_PROVIDER=mock

# Ollama — can run on another machine on your network. On that machine, start Ollama with
# OLLAMA_HOST=0.0.0.0 so it accepts network connections, and pull the model (ollama pull llama3.1).
OLLAMA_BASE_URL=http://192.168.1.50:11434
OLLAMA_MODEL=llama3.1

# OpenAI-compatible API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Seconds to wait for an LLM response (local models can be slow). Connecting times out after 10 s.
AP_LLM_TIMEOUT=180

# Matching tolerances (price variance must be within BOTH limits)
AP_QUANTITY_TOLERANCE=0
AP_PRICE_TOLERANCE_AMOUNT=25.00
AP_PRICE_TOLERANCE_PERCENT=5.0

# AI coding confidence bands
AP_CONFIDENCE_STRAIGHT_THROUGH=0.90
AP_CONFIDENCE_REVIEW=0.75

# Approval thresholds
AP_AUTO_APPROVAL_LIMIT=1000.00
AP_CONTROLLER_THRESHOLD=10000.00

# Duplicate detection look-back window for same-vendor/same-amount matches
AP_DUPLICATE_WINDOW_DAYS=60
